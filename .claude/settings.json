{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ninja *)",
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(ccache *)",
      "Bash(scripts/build.sh *)",
      "Bash(scripts/check-identity.sh *)",
      "Bash(git *)",
      "Bash(python3 *)",
      "Bash(g++ *)",
      "Bash(df *)",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(brew install *)",
      "Bash(scripts/install.sh *)",
      "Bash(scripts/sync-upstream.sh *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Edit(//Applications/MuseScore 4.app/**)",
      "Write(//Applications/MuseScore 4.app/**)",
      "Edit(//Applications/MuseScore Studio 4.app/**)",
      "Write(//Applications/MuseScore Studio 4.app/**)",
      "Edit(//usr/local/lib/libMuseSampler*)",
      "Write(//usr/local/lib/libMuseSampler*)",
      "Edit(~/Library/Application Support/MuseScore/MuseScore4/**)",
      "Write(~/Library/Application Support/MuseScore/MuseScore4/**)",
      "Edit(~/Library/Application Support/MuseSampler/**)",
      "Write(~/Library/Application Support/MuseSampler/**)",
      "Edit(./tests/fixtures/real/**)",
      "Write(./tests/fixtures/real/**)"
    ]
  }
}
